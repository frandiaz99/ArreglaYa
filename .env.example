# Claude API (o usar `ant auth login`)
ANTHROPIC_API_KEY=

# Modelos (por defecto Haiku 5.5 en ambos). Para guías más cuidadas: claude-opus-5-5
CLAUDE_MODEL_DIAGNOSIS=claude-haiku-5-5
CLAUDE_MODEL_GUIDE=claude-haiku-5-5

# Protección de costos
DAILY_BUDGET_USD=5
DIAGNOSES_PER_HOUR=10
GUIDES_PER_HOUR=3

PORT=3000
# Si corre detrás de un proxy (Cloudflare, nginx, Render…): cantidad de saltos, ej. 1
TRUST_PROXY=

# WhatsApp Cloud API (opcional, solo si conectás el bot)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
